#include "w_10535_lan_configuration/LanConfiguration.h"
#include "WppClient.h"
#include "WppRegistry.h"
#include "WppLogs.h"

#ifdef OBJ_W_10535_LAN_CONFIGURATION

#include <cstdio>
#include <cstring>
#include <sstream>
#include <fstream>
#include <regex>
#include <arpa/inet.h>

#define TAG "LanConfiguration"

using namespace wpp;

/* Static object methods */
Object& LanConfiguration::object(WppClient& ctx) {
    return client.registry().getObject(LAN_CONFIGURATION_OBJECT_ID);
}

Instance* LanConfiguration::createInst(WppClient& ctx, ID_T instId) {
    return object(client).createInstance(instId);
}

Instance* LanConfiguration::instance(WppClient& ctx, ID_T instId) {
    return object(client).instance(instId);
}

bool LanConfiguration::removeInst(WppClient& ctx, ID_T instId) {
    return object(client).remove(instId);
}

/* Instance lifecycle */
LanConfiguration::LanConfiguration(Object& object, ID_T instId)
    : Instance(object, instId) {
    WPP_LOGD(TAG, "LanConfiguration instance %d created", instId);
}

LanConfiguration::~LanConfiguration() {
    WPP_LOGD(TAG, "LanConfiguration instance %d destroyed", instId());
}

/* Initialize resources */
bool LanConfiguration::initResources(ItemOp *itemOp) {
    WPP_LOGD(TAG, "Initializing LanConfiguration resources for instance %d", instId());

    // Default LAN configuration values
    set<STRING_T>(LAN_IP_ADDRESS_0, "192.168.1.1");
    set<STRING_T>(SUBNET_MASK_1, "255.255.255.0");
    set<BOOL_T>(DHCP_ENABLED_2, true);
    set<STRING_T>(DHCP_POOL_START_3, "192.168.1.100");
    set<STRING_T>(DHCP_POOL_END_4, "192.168.1.250");
    set<INT_T>(DHCP_LEASE_TIME_5, 43200);  // 12 hours in seconds
    set<STRING_T>(DNS_SERVER_PRIMARY_6, "8.8.8.8");
    set<STRING_T>(DNS_SERVER_SECONDARY_7, "8.8.4.4");
    set<STRING_T>(DOMAIN_NAME_8, "lan");
    set<INT_T>(CONFIGURATION_STATUS_12, STATUS_PENDING);

    // Set execute handler
    setExecute(APPLY_CONFIGURATION_11, applyConfiguration);

#ifdef OPENWRT_BUILD
    // Load existing configuration from UCI if available
    loadFromUCI();
    // Load active DHCP leases
    loadActiveLeases();
#endif

    return true;
}

/* Validation */
bool LanConfiguration::validate(ID_T resId, const void *data, size_t size) {
    switch (resId) {
        case LAN_IP_ADDRESS_0:
        case DHCP_POOL_START_3:
        case DHCP_POOL_END_4:
        case DNS_SERVER_PRIMARY_6:
        case DNS_SERVER_SECONDARY_7: {
            const STRING_T& ip = *(const STRING_T*)data;
            if (!isValidIPv4(ip)) {
                WPP_LOGE(TAG, "Invalid IPv4 address: %s", ip.c_str());
                return false;
            }
            break;
        }
        case SUBNET_MASK_1: {
            const STRING_T& mask = *(const STRING_T*)data;
            if (!isValidIPv4(mask)) {
                WPP_LOGE(TAG, "Invalid subnet mask: %s", mask.c_str());
                return false;
            }
            // Verify it's a valid subnet mask
            struct in_addr addr;
            if (inet_pton(AF_INET, mask.c_str(), &addr) == 1) {
                uint32_t maskVal = ntohl(addr.s_addr);
                // Check if it's a valid subnet mask (contiguous 1s followed by contiguous 0s)
                if ((maskVal & (~maskVal >> 1)) != 0) {
                    WPP_LOGE(TAG, "Invalid subnet mask format: %s", mask.c_str());
                    return false;
                }
            }
            break;
        }
        case STATIC_LEASES_9: {
            const STRING_T& lease = *(const STRING_T*)data;
            // Format: MAC:IP
            size_t colonPos = lease.find(':');
            if (colonPos == std::string::npos) {
                WPP_LOGE(TAG, "Invalid static lease format (expected MAC:IP): %s", lease.c_str());
                return false;
            }
            std::string mac = lease.substr(0, colonPos);
            std::string ip = lease.substr(colonPos + 1);
            if (!isValidMAC(mac) || !isValidIPv4(ip)) {
                WPP_LOGE(TAG, "Invalid MAC or IP in static lease: %s", lease.c_str());
                return false;
            }
            break;
        }
        case DHCP_LEASE_TIME_5: {
            INT_T leaseTime = *(const INT_T*)data;
            if (leaseTime < 60 || leaseTime > 604800) {  // 1 minute to 7 days
                WPP_LOGE(TAG, "Invalid DHCP lease time: %lld (must be 60-604800 seconds)", leaseTime);
                return false;
            }
            break;
        }
    }
    return true;
}

/* Execute handler: Apply Configuration */
bool LanConfiguration::applyConfiguration(Instance& inst, ID_T resId, const OPAQUE_T& data) {
    LanConfiguration& lan = static_cast<LanConfiguration&>(inst);

    WPP_LOGI(TAG, "Applying LAN configuration for instance %d", lan.instId());

    // Set status to pending
    lan.set<INT_T>(CONFIGURATION_STATUS_12, STATUS_PENDING);

#ifdef OPENWRT_BUILD
    // Save to UCI configuration
    if (!lan.saveToUCI()) {
        WPP_LOGE(TAG, "Failed to save LAN configuration to UCI");
        lan.set<INT_T>(CONFIGURATION_STATUS_12, STATUS_ERROR);
        return false;
    }

    // Apply DHCP configuration
    if (!lan.applyDhcpConfig()) {
        WPP_LOGE(TAG, "Failed to apply DHCP configuration");
        lan.set<INT_T>(CONFIGURATION_STATUS_12, STATUS_ERROR);
        return false;
    }

    // Set status to applied
    lan.set<INT_T>(CONFIGURATION_STATUS_12, STATUS_APPLIED);
    WPP_LOGI(TAG, "LAN configuration applied successfully");

    // Reload active leases after applying configuration
    lan.loadActiveLeases();

    return true;
#else
    WPP_LOGW(TAG, "OpenWRT build not enabled, cannot apply LAN configuration");
    lan.set<INT_T>(CONFIGURATION_STATUS_12, STATUS_ERROR);
    return false;
#endif
}

/* Load configuration from UCI */
bool LanConfiguration::loadFromUCI() {
#ifdef OPENWRT_BUILD
    WPP_LOGD(TAG, "Loading LAN configuration from UCI");

    // Get LAN interface name (usually 'lan')
    std::string ifname = "lan";

    // Read IP address
    std::stringstream cmd;
    cmd << "uci get network." << ifname << ".ipaddr 2>/dev/null";
    FILE* pipe = popen(cmd.str().c_str(), "r");
    if (pipe) {
        char buffer[256];
        if (fgets(buffer, sizeof(buffer), pipe)) {
            buffer[strcspn(buffer, "\n")] = 0;
            set<STRING_T>(LAN_IP_ADDRESS_0, buffer);
        }
        pclose(pipe);
    }

    // Read subnet mask (netmask)
    cmd.str("");
    cmd << "uci get network." << ifname << ".netmask 2>/dev/null";
    pipe = popen(cmd.str().c_str(), "r");
    if (pipe) {
        char buffer[256];
        if (fgets(buffer, sizeof(buffer), pipe)) {
            buffer[strcspn(buffer, "\n")] = 0;
            set<STRING_T>(SUBNET_MASK_1, buffer);
        }
        pclose(pipe);
    }

    // Read DHCP pool start
    cmd.str("");
    cmd << "uci get dhcp." << ifname << ".start 2>/dev/null";
    pipe = popen(cmd.str().c_str(), "r");
    if (pipe) {
        char buffer[256];
        if (fgets(buffer, sizeof(buffer), pipe)) {
            buffer[strcspn(buffer, "\n")] = 0;
            // OpenWRT stores start as offset from network address
            int offset = atoi(buffer);
            std::string networkAddr = calculateNetworkAddress();
            struct in_addr addr;
            inet_pton(AF_INET, networkAddr.c_str(), &addr);
            addr.s_addr = htonl(ntohl(addr.s_addr) + offset);
            char startIp[INET_ADDRSTRLEN];
            inet_ntop(AF_INET, &addr, startIp, INET_ADDRSTRLEN);
            set<STRING_T>(DHCP_POOL_START_3, startIp);
        }
        pclose(pipe);
    }

    // Read DHCP pool limit (size)
    cmd.str("");
    cmd << "uci get dhcp." << ifname << ".limit 2>/dev/null";
    pipe = popen(cmd.str().c_str(), "r");
    if (pipe) {
        char buffer[256];
        if (fgets(buffer, sizeof(buffer), pipe)) {
            buffer[strcspn(buffer, "\n")] = 0;
            int limit = atoi(buffer);
            // Calculate end IP from start + limit
            std::string startIp = get<STRING_T>(DHCP_POOL_START_3);
            struct in_addr addr;
            inet_pton(AF_INET, startIp.c_str(), &addr);
            addr.s_addr = htonl(ntohl(addr.s_addr) + limit - 1);
            char endIp[INET_ADDRSTRLEN];
            inet_ntop(AF_INET, &addr, endIp, INET_ADDRSTRLEN);
            set<STRING_T>(DHCP_POOL_END_4, endIp);
        }
        pclose(pipe);
    }

    // Read DHCP lease time
    cmd.str("");
    cmd << "uci get dhcp." << ifname << ".leasetime 2>/dev/null";
    pipe = popen(cmd.str().c_str(), "r");
    if (pipe) {
        char buffer[256];
        if (fgets(buffer, sizeof(buffer), pipe)) {
            buffer[strcspn(buffer, "\n")] = 0;
            // Parse lease time (format: 12h, 1d, etc.)
            std::string leaseStr(buffer);
            int seconds = 43200;  // Default 12 hours
            if (leaseStr.back() == 'h') {
                seconds = atoi(leaseStr.c_str()) * 3600;
            } else if (leaseStr.back() == 'd') {
                seconds = atoi(leaseStr.c_str()) * 86400;
            } else if (leaseStr.back() == 'm') {
                seconds = atoi(leaseStr.c_str()) * 60;
            } else {
                seconds = atoi(leaseStr.c_str());
            }
            set<INT_T>(DHCP_LEASE_TIME_5, seconds);
        }
        pclose(pipe);
    }

    // Read domain name
    cmd.str("");
    cmd << "uci get dhcp." << ifname << ".domain 2>/dev/null";
    pipe = popen(cmd.str().c_str(), "r");
    if (pipe) {
        char buffer[256];
        if (fgets(buffer, sizeof(buffer), pipe)) {
            buffer[strcspn(buffer, "\n")] = 0;
            set<STRING_T>(DOMAIN_NAME_8, buffer);
        }
        pclose(pipe);
    }

    // Read DNS servers from /tmp/resolv.conf.d/resolv.conf.auto
    std::ifstream resolvFile("/tmp/resolv.conf.d/resolv.conf.auto");
    if (resolvFile.is_open()) {
        std::string line;
        int dnsCount = 0;
        while (std::getline(resolvFile, line) && dnsCount < 2) {
            if (line.find("nameserver") == 0) {
                std::istringstream iss(line);
                std::string keyword, ip;
                iss >> keyword >> ip;
                if (dnsCount == 0) {
                    set<STRING_T>(DNS_SERVER_PRIMARY_6, ip);
                } else {
                    set<STRING_T>(DNS_SERVER_SECONDARY_7, ip);
                }
                dnsCount++;
            }
        }
        resolvFile.close();
    }

    // Check if DHCP is enabled
    cmd.str("");
    cmd << "uci get dhcp." << ifname << ".ignore 2>/dev/null";
    pipe = popen(cmd.str().c_str(), "r");
    if (pipe) {
        char buffer[16];
        if (fgets(buffer, sizeof(buffer), pipe)) {
            // ignore=1 means DHCP is disabled
            set<BOOL_T>(DHCP_ENABLED_2, (buffer[0] != '1'));
        } else {
            // If ignore is not set, DHCP is enabled by default
            set<BOOL_T>(DHCP_ENABLED_2, true);
        }
        pclose(pipe);
    }

    WPP_LOGD(TAG, "Loaded LAN configuration from UCI");
    return true;
#else
    return false;
#endif
}

/* Save configuration to UCI */
bool LanConfiguration::saveToUCI() {
#ifdef OPENWRT_BUILD
    WPP_LOGD(TAG, "Saving LAN configuration to UCI");

    std::string ifname = "lan";
    std::stringstream cmd;

    // Set IP address
    cmd.str("");
    cmd << "uci set network." << ifname << ".ipaddr='"
        << get<STRING_T>(LAN_IP_ADDRESS_0) << "'";
    system(cmd.str().c_str());

    // Set subnet mask
    cmd.str("");
    cmd << "uci set network." << ifname << ".netmask='"
        << get<STRING_T>(SUBNET_MASK_1) << "'";
    system(cmd.str().c_str());

    // Commit network changes
    system("uci commit network");

    // Calculate DHCP start offset and limit
    std::string networkAddr = calculateNetworkAddress();
    std::string startIp = get<STRING_T>(DHCP_POOL_START_3);
    std::string endIp = get<STRING_T>(DHCP_POOL_END_4);

    struct in_addr netAddr, startAddr, endAddr;
    inet_pton(AF_INET, networkAddr.c_str(), &netAddr);
    inet_pton(AF_INET, startIp.c_str(), &startAddr);
    inet_pton(AF_INET, endIp.c_str(), &endAddr);

    int start_offset = ntohl(startAddr.s_addr) - ntohl(netAddr.s_addr);
    int limit = ntohl(endAddr.s_addr) - ntohl(startAddr.s_addr) + 1;

    // Set DHCP pool start
    cmd.str("");
    cmd << "uci set dhcp." << ifname << ".start='" << start_offset << "'";
    system(cmd.str().c_str());

    // Set DHCP pool limit
    cmd.str("");
    cmd << "uci set dhcp." << ifname << ".limit='" << limit << "'";
    system(cmd.str().c_str());

    // Set DHCP lease time
    INT_T leaseSeconds = get<INT_T>(DHCP_LEASE_TIME_5);
    cmd.str("");
    if (leaseSeconds % 3600 == 0) {
        cmd << "uci set dhcp." << ifname << ".leasetime='" << (leaseSeconds / 3600) << "h'";
    } else if (leaseSeconds % 60 == 0) {
        cmd << "uci set dhcp." << ifname << ".leasetime='" << (leaseSeconds / 60) << "m'";
    } else {
        cmd << "uci set dhcp." << ifname << ".leasetime='" << leaseSeconds << "'";
    }
    system(cmd.str().c_str());

    // Set domain name
    cmd.str("");
    cmd << "uci set dhcp." << ifname << ".domain='"
        << get<STRING_T>(DOMAIN_NAME_8) << "'";
    system(cmd.str().c_str());

    // Set DHCP enabled/disabled
    cmd.str("");
    cmd << "uci set dhcp." << ifname << ".ignore='"
        << (get<BOOL_T>(DHCP_ENABLED_2) ? "0" : "1") << "'";
    system(cmd.str().c_str());

    // Handle static leases
    std::vector<STRING_T> staticLeases;
    if (getMultiple(STATIC_LEASES_9, staticLeases)) {
        // First, remove existing static leases for this interface
        cmd.str("");
        cmd << "for i in $(uci show dhcp | grep \"=host\" | cut -d'[' -f2 | cut -d']' -f1); do "
            << "if [ \"$(uci get dhcp.@host[$i].dhcp_option 2>/dev/null | grep " << ifname << ")\" ]; then "
            << "uci delete dhcp.@host[$i]; fi; done";
        system(cmd.str().c_str());

        // Add new static leases
        for (const auto& lease : staticLeases) {
            size_t colonPos = lease.find(':');
            if (colonPos != std::string::npos) {
                std::string mac = lease.substr(0, colonPos);
                std::string ip = lease.substr(colonPos + 1);

                cmd.str("");
                cmd << "SECTION=$(uci add dhcp host) && "
                    << "uci set dhcp.$SECTION.mac='" << mac << "' && "
                    << "uci set dhcp.$SECTION.ip='" << ip << "' && "
                    << "uci set dhcp.$SECTION.dns='1'";
                system(cmd.str().c_str());
            }
        }
    }

    // Commit DHCP changes
    system("uci commit dhcp");

    WPP_LOGD(TAG, "Saved LAN configuration to UCI");
    return true;
#else
    return false;
#endif
}

/* Apply DHCP configuration */
bool LanConfiguration::applyDhcpConfig() {
#ifdef OPENWRT_BUILD
    WPP_LOGI(TAG, "Applying DHCP configuration");

    // Restart network interface
    int result = system("/etc/init.d/network reload");
    if (result != 0) {
        WPP_LOGE(TAG, "Failed to reload network");
        return false;
    }

    // Restart dnsmasq (DHCP/DNS server)
    result = system("/etc/init.d/dnsmasq restart");
    if (result != 0) {
        WPP_LOGE(TAG, "Failed to restart dnsmasq");
        return false;
    }

    return true;
#else
    return false;
#endif
}

/* Load active DHCP leases */
bool LanConfiguration::loadActiveLeases() {
#ifdef OPENWRT_BUILD
    WPP_LOGD(TAG, "Loading active DHCP leases");

    // Clear existing active leases
    clearResource(ACTIVE_LEASES_10);

    // Read from /tmp/dhcp.leases
    std::ifstream leaseFile("/tmp/dhcp.leases");
    if (!leaseFile.is_open()) {
        WPP_LOGW(TAG, "Could not open /tmp/dhcp.leases");
        return false;
    }

    std::string line;
    while (std::getline(leaseFile, line)) {
        // Format: timestamp mac ip hostname client_id
        std::istringstream iss(line);
        std::string timestamp, mac, ip, hostname, clientId;

        if (iss >> timestamp >> mac >> ip >> hostname) {
            // Calculate expiry time
            time_t expiryTime = std::stoll(timestamp);
            time_t currentTime = time(nullptr);
            int remainingSeconds = expiryTime - currentTime;

            // Format: MAC:IP:hostname:expiry_seconds
            std::stringstream leaseStr;
            leaseStr << mac << ":" << ip << ":"
                     << (hostname == "*" ? "unknown" : hostname) << ":"
                     << remainingSeconds;

            // Add to multiple instance resource
            addToMultiple(ACTIVE_LEASES_10, leaseStr.str());
        }
    }

    leaseFile.close();
    WPP_LOGD(TAG, "Loaded active DHCP leases");
    return true;
#else
    return false;
#endif
}

/* Validate IPv4 address */
bool LanConfiguration::isValidIPv4(const std::string& ip) {
    struct sockaddr_in sa;
    return inet_pton(AF_INET, ip.c_str(), &(sa.sin_addr)) == 1;
}

/* Validate MAC address */
bool LanConfiguration::isValidMAC(const std::string& mac) {
    // MAC format: XX:XX:XX:XX:XX:XX or XX-XX-XX-XX-XX-XX
    std::regex macRegex("^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$");
    return std::regex_match(mac, macRegex);
}

/* Calculate network address from IP and subnet mask */
std::string LanConfiguration::calculateNetworkAddress() {
    std::string ip = get<STRING_T>(LAN_IP_ADDRESS_0);
    std::string mask = get<STRING_T>(SUBNET_MASK_1);

    struct in_addr ipAddr, maskAddr, netAddr;
    inet_pton(AF_INET, ip.c_str(), &ipAddr);
    inet_pton(AF_INET, mask.c_str(), &maskAddr);

    netAddr.s_addr = ipAddr.s_addr & maskAddr.s_addr;

    char networkAddr[INET_ADDRSTRLEN];
    inet_ntop(AF_INET, &netAddr, networkAddr, INET_ADDRSTRLEN);

    return std::string(networkAddr);
}

/* Convert subnet mask to CIDR notation */
int LanConfiguration::cidrFromSubnetMask(const std::string& mask) {
    struct in_addr addr;
    inet_pton(AF_INET, mask.c_str(), &addr);

    uint32_t maskVal = ntohl(addr.s_addr);
    int cidr = 0;

    while (maskVal) {
        cidr += (maskVal & 1);
        maskVal >>= 1;
    }

    return cidr;
}

#endif // OBJ_W_10535_LAN_CONFIGURATION
