@PACKAGE_INIT@

# FriendlyLwM2M CMake Config File
# This file is used by CMake's find_package() to locate and configure FriendlyLwM2M

include(CMakeFindDependencyMacro)

# Find required dependencies
if(@WITH_DTLS@)
    if(@WITH_MBEDTLS@)
        find_dependency(MbedTLS)
    else()
        find_dependency(OpenSSL)
    endif()
endif()

if(@WITH_MQTT@)
    find_dependency(Paho)
endif()

# Include the exported targets
include("${CMAKE_CURRENT_LIST_DIR}/FriendlyLwM2MTargets.cmake")

# Set variables for consumers
set(FriendlyLwM2M_FOUND TRUE)
set(FriendlyLwM2M_VERSION @PROJECT_VERSION@)
set(FriendlyLwM2M_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(FriendlyLwM2M_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(FriendlyLwM2M_VERSION_PATCH @PROJECT_VERSION_PATCH@)

# Feature flags
set(FriendlyLwM2M_WITH_DTLS @WITH_DTLS@)
set(FriendlyLwM2M_WITH_MBEDTLS @WITH_MBEDTLS@)
set(FriendlyLwM2M_WITH_TINYDTLS @WITH_TINYDTLS@)
set(FriendlyLwM2M_WITH_DELTA_FOTA @WITH_DELTA_FOTA@)
set(FriendlyLwM2M_WITH_MQTT @WITH_MQTT@)
set(FriendlyLwM2M_WITH_EDGE_AI @WITH_EDGE_AI@)

# Component libraries
set(FriendlyLwM2M_LIBRARIES wpp wakaama)

if(@WITH_DELTA_FOTA@)
    list(APPEND FriendlyLwM2M_LIBRARIES delta_fota)
endif()

if(@WITH_MQTT@)
    list(APPEND FriendlyLwM2M_LIBRARIES mqtt_transport)
endif()

if(@WITH_EDGE_AI@)
    list(APPEND FriendlyLwM2M_LIBRARIES edge_ai)
endif()

# Include directories
set(FriendlyLwM2M_INCLUDE_DIRS
    "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@"
    "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/wpp"
    "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/wakaama"
)

check_required_components(FriendlyLwM2M)
