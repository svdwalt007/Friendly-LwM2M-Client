# Git Attributes Configuration
# Enforces consistent line endings across platforms

# Auto-detect text files and normalize line endings to LF in repository
* text=auto

# ============================================================================
# Shell Scripts - MUST use Unix (LF) line endings
# ============================================================================
# Shell scripts fail on Linux if they have DOS (CRLF) line endings
# Error: /bin/bash^M: bad interpreter: No such file or directory

*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# ============================================================================
# Linux Configuration Files - Force LF
# ============================================================================

*.conf text eol=lf
*.service text eol=lf
*.socket text eol=lf
*.timer text eol=lf
Makefile text eol=lf
*.mk text eol=lf

# ============================================================================
# Source Code - Normalize to LF
# ============================================================================

*.c text eol=lf
*.cpp text eol=lf
*.cc text eol=lf
*.cxx text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.hxx text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.java text eol=lf
*.go text eol=lf
*.rs text eol=lf

# ============================================================================
# Build System Files - Force LF
# ============================================================================

CMakeLists.txt text eol=lf
*.cmake text eol=lf
*.cmake.in text eol=lf
configure text eol=lf
configure.ac text eol=lf
Makefile.am text eol=lf

# ============================================================================
# Documentation - Normalize to LF
# ============================================================================

*.md text eol=lf
*.txt text eol=lf
*.adoc text eol=lf
*.rst text eol=lf
*.tex text eol=lf

# ============================================================================
# Data Files - Normalize to LF
# ============================================================================

*.json text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf

# ============================================================================
# Git Files - Force LF
# ============================================================================

.gitattributes text eol=lf
.gitignore text eol=lf
.gitmodules text eol=lf

# ============================================================================
# CI/CD Files - Force LF
# ============================================================================

.gitlab-ci.yml text eol=lf
.travis.yml text eol=lf
Jenkinsfile text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf
*.dockerignore text eol=lf

# ============================================================================
# Windows-Specific Files - Allow CRLF
# ============================================================================

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ============================================================================
# Binary Files - Do Not Modify
# ============================================================================

# Archives
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.xz binary
*.7z binary
*.rar binary

# Executables
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.lib binary
*.o binary
*.obj binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.bmp binary
*.webp binary

# Documents
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary

# Media
*.mp3 binary
*.mp4 binary
*.wav binary
*.flac binary
*.avi binary
*.mkv binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

# Other binary formats
*.db binary
*.sqlite binary
*.dat binary
*.bin binary

# ============================================================================
# Language-Specific Settings
# ============================================================================

# Python
*.py diff=python

# C/C++
*.c diff=cpp
*.h diff=cpp
*.cpp diff=cpp
*.hpp diff=cpp

# Java
*.java diff=java

# Markdown
*.md diff=markdown

# ============================================================================
# Export Ignore (for git archive)
# ============================================================================

.gitattributes export-ignore
.gitignore export-ignore
.github export-ignore
.gitlab export-ignore
.travis.yml export-ignore
tests export-ignore
docs/archive export-ignore
