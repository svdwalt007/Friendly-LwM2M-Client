# LwM2M Client Configuration for OpenWRT One
# Walt Technologies

config lwm2m-client 'config'
	option enabled '1'
	option bootstrap_uri 'coap://demo-iot.friendly-tech.com:5680'
	option endpoint_name 'walttech888'
	option local_port '56830'
	option log_level '0'

# WiFi Management Settings
config wifi 'settings'
	option enable_2ghz '1'
	option enable_5ghz '1'
	option auto_channel '1'

# System Monitoring Settings
config monitoring 'settings'
	option enable_cpu_monitor '1'
	option enable_memory_monitor '1'
	option enable_storage_monitor '1'
	option update_interval '60'

# Network Interface Settings
config network 'settings'
	option enable_wan_monitor '1'
	option enable_lan_monitor '1'
