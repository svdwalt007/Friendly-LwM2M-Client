#!/bin/sh /etc/rc.common
#
# LwM2M Client init script for OpenWRT One
# Walt Technologies
#

START=95
STOP=10

USE_PROCD=1
PROG=/usr/sbin/lwm2m-client
CONF_FILE=/etc/lwm2m/endpoint.conf

start_service() {
	local enabled bootstrap_uri endpoint_name local_port

	config_load 'lwm2m-client'
	config_get enabled config 'enabled' '1'
	config_get bootstrap_uri config 'bootstrap_uri' 'coap://demo-iot.friendly-tech.com:5680'
	config_get endpoint_name config 'endpoint_name' 'walttech888'
	config_get local_port config 'local_port' '56830'

	[ "$enabled" = "1" ] || {
		echo "LwM2M Client is disabled in config"
		return 1
	}

	# Create configuration file
	cat > "$CONF_FILE" <<-EOF
		# LwM2M Client Configuration
		# Generated by init script
		BOOTSTRAP_URI=$bootstrap_uri
		ENDPOINT_NAME=$endpoint_name
		LOCAL_PORT=$local_port
	EOF

	procd_open_instance
	procd_set_param command $PROG
	procd_set_param env BOOTSTRAP_URI="$bootstrap_uri"
	procd_set_param env ENDPOINT_NAME="$endpoint_name"
	procd_set_param env LOCAL_PORT="$local_port"
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/lwm2m-client.pid
	procd_close_instance

	logger -t lwm2m-client "Started LwM2M Client - Endpoint: $endpoint_name, Bootstrap: $bootstrap_uri"
}

stop_service() {
	logger -t lwm2m-client "Stopping LwM2M Client"
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "lwm2m-client"
}
