#!/bin/sh /etc/rc.common
# Friendly LwM2M Client init script
# /etc/init.d/lwm2m

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/friendly_lwm2m_client
CONFIG=/etc/friendly-lwm2m/config.json

validate_section_lwm2m() {
    uci_load_validate lwm2m lwm2m "$1" "$2" \
        'enabled:bool:1' \
        'endpoint:string' \
        'lifetime:uinteger:300' \
        'binding:string:U'
}

validate_section_server() {
    uci_load_validate lwm2m server "$1" "$2" \
        'enabled:bool:1' \
        'uri:string' \
        'security_mode:string:psk' \
        'psk_identity:string' \
        'psk_key:string' \
        'bootstrap:bool:0'
}

validate_section_firmware() {
    uci_load_validate lwm2m firmware "$1" "$2" \
        'delta_enabled:bool:1' \
        'delta_algorithm:string:bsdiff' \
        'rollback_enabled:bool:1' \
        'auto_reboot:bool:1' \
        'reboot_delay:uinteger:5' \
        'download_path:string:/tmp/firmware' \
        'backup_path:string:/var/lib/lwm2m/snapshots' \
        'max_snapshots:uinteger:3'
}

generate_config() {
    local endpoint lifetime binding
    local server_uri security_mode psk_identity psk_key
    local delta_enabled delta_algorithm rollback_enabled
    
    config_load lwm2m
    
    # Load client config
    config_get endpoint client endpoint "friendly-device-001"
    config_get lifetime client lifetime "300"
    config_get binding client binding "U"
    
    # Load server config
    config_get server_uri server1 uri ""
    config_get security_mode server1 security_mode "psk"
    config_get psk_identity server1 psk_identity ""
    config_get psk_key server1 psk_key ""
    
    # Load firmware config
    config_get delta_enabled update delta_enabled "1"
    config_get delta_algorithm update delta_algorithm "bsdiff"
    config_get rollback_enabled update rollback_enabled "1"
    config_get download_path update download_path "/tmp/firmware"
    config_get backup_path update backup_path "/var/lib/lwm2m/snapshots"
    
    # Create config directory
    mkdir -p /etc/friendly-lwm2m
    mkdir -p "$download_path"
    mkdir -p "$backup_path"
    
    # Generate JSON config
    cat > "$CONFIG" <<EOF
{
    "endpoint": "$endpoint",
    "server": {
        "uri": "$server_uri",
        "lifetime": $lifetime,
        "binding": "$binding"
    },
    "security": {
        "mode": "$security_mode",
        "psk_identity": "$psk_identity",
        "psk_key": "$psk_key"
    },
    "firmware": {
        "delta_enabled": $([ "$delta_enabled" = "1" ] && echo "true" || echo "false"),
        "delta_algorithm": "$delta_algorithm",
        "rollback_enabled": $([ "$rollback_enabled" = "1" ] && echo "true" || echo "false"),
        "download_path": "$download_path",
        "backup_path": "$backup_path"
    }
}
EOF
}

start_service() {
    local enabled
    
    config_load lwm2m
    config_get_bool enabled client enabled 1
    
    [ "$enabled" -eq 0 ] && return
    
    generate_config
    
    procd_open_instance
    procd_set_param command "$PROG" --config "$CONFIG"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/lwm2m.pid
    procd_close_instance
}

stop_service() {
    # Mark boot as successful before stopping
    # This prevents accidental rollback during service restart
    if [ -x "$PROG" ]; then
        "$PROG" --mark-boot-success 2>/dev/null || true
    fi
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger "lwm2m"
}

boot() {
    # Check if we need to verify boot success
    local upgrade_pending
    upgrade_pending=$(fw_printenv upgrade_available 2>/dev/null | cut -d= -f2)
    
    if [ "$upgrade_pending" = "1" ]; then
        logger -t lwm2m "Boot verification pending after firmware update"
        # Start service with boot verification mode
        start
    else
        start
    fi
}

# Mark boot as successful (called after successful verification)
mark_boot_success() {
    fw_setenv upgrade_available 0 2>/dev/null || true
    
    # Get current slot and mark as bootable
    local current_slot
    current_slot=$(fw_printenv active_slot 2>/dev/null | cut -d= -f2)
    
    if [ "$current_slot" = "b" ]; then
        fw_setenv slot_b_bootable 1 2>/dev/null || true
    else
        fw_setenv slot_a_bootable 1 2>/dev/null || true
    fi
    
    logger -t lwm2m "Boot marked as successful"
}
