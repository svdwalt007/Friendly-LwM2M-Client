#!/bin/sh
# LwM2M Client Network Interface Hotplug Handler
# Copyright (C) 2024 Friendly Technologies
#
# This script is triggered by OpenWRT's hotplug system when network
# interfaces change state (ifup/ifdown). It notifies the LwM2M client
# daemon and updates relevant object resources.
#
# Environment variables provided by hotplug:
# - ACTION: "ifup" or "ifdown"
# - INTERFACE: Interface name (e.g., "wan", "lan")
# - DEVICE: Physical device name (e.g., "eth0", "wlan0")

# Exit if not enabled
[ -f /etc/config/lwm2m ] || exit 0
[ "$(uci -q get lwm2m.general.enabled 2>/dev/null)" = "1" ] || exit 0

# Logging function
log_lwm2m() {
	logger -t lwm2m-hotplug -p daemon.info "$@"
}

log_error() {
	logger -t lwm2m-hotplug -p daemon.err "$@"
}

# Check if LwM2M client is running
is_lwm2m_running() {
	pgrep -x lwm2m-client >/dev/null 2>&1
	return $?
}

# Send event via ubus
notify_ubus() {
	local event="$1"
	local data="$2"

	if ! command -v ubus >/dev/null 2>&1; then
		log_error "ubus command not found"
		return 1
	fi

	# Check if lwm2m ubus object exists
	if ! ubus list | grep -q "^lwm2m$"; then
		log_lwm2m "LwM2M ubus object not available, skipping notification"
		return 1
	fi

	# Send event via ubus
	if ubus send "lwm2m.${event}" "${data}" 2>/dev/null; then
		log_lwm2m "Sent ubus event: lwm2m.${event}"
		return 0
	else
		log_error "Failed to send ubus event: lwm2m.${event}"
		return 1
	fi
}

# Trigger LwM2M client update via ubus method call
trigger_update() {
	if ! command -v ubus >/dev/null 2>&1; then
		return 1
	fi

	if ubus list | grep -q "^lwm2m$"; then
		# Call update method to trigger registration update
		ubus call lwm2m update 2>/dev/null || true
	fi
}

# Update Connectivity Monitoring object (Object ID 4)
update_connectivity_monitoring() {
	local interface="$1"
	local action="$2"

	# Determine if this is the primary WAN interface
	local is_wan=0
	[ "$interface" = "wan" ] || [ "$interface" = "wan6" ] && is_wan=1

	if [ $is_wan -eq 1 ]; then
		log_lwm2m "Primary WAN interface $interface changed: $action"

		# Build ubus notification data
		local json_data="{\"interface\":\"${interface}\",\"action\":\"${action}\",\"device\":\"${DEVICE:-unknown}\"}"

		# Notify via ubus event
		notify_ubus "interface.${action}" "${json_data}"

		# Trigger update to re-read network bearer and IP addresses
		if [ "$action" = "ifup" ]; then
			sleep 2  # Allow network to stabilize
			trigger_update
		fi
	fi
}

# Update Ethernet Interface object (Object ID 34602)
update_ethernet_interface() {
	local interface="$1"
	local action="$2"
	local device="${DEVICE:-}"

	# Only process physical ethernet interfaces
	case "$device" in
		eth*)
			log_lwm2m "Ethernet interface $device changed: $action"

			local link_status="down"
			[ "$action" = "ifup" ] && link_status="up"

			# Build notification data
			local json_data="{\"interface\":\"${interface}\",\"device\":\"${device}\",\"status\":\"${link_status}\"}"

			# Notify via ubus
			notify_ubus "ethernet.${action}" "${json_data}"
			;;
		*)
			# Not an ethernet interface, skip
			;;
	esac
}

# Main hotplug handler
main() {
	local action="${ACTION:-}"
	local interface="${INTERFACE:-}"
	local device="${DEVICE:-}"

	# Validate required variables
	if [ -z "$action" ] || [ -z "$interface" ]; then
		log_error "Missing ACTION or INTERFACE in hotplug environment"
		exit 1
	fi

	# Only process ifup and ifdown actions
	case "$action" in
		ifup|ifdown)
			log_lwm2m "Interface event: action=$action interface=$interface device=$device"
			;;
		*)
			# Ignore other actions
			exit 0
			;;
	esac

	# Check if LwM2M client is running
	if ! is_lwm2m_running; then
		log_lwm2m "LwM2M client not running, skipping event processing"
		exit 0
	fi

	# Update relevant LwM2M objects
	update_connectivity_monitoring "$interface" "$action"
	update_ethernet_interface "$interface" "$action"

	log_lwm2m "Interface event processed successfully"
}

# Execute main function
main "$@"
exit 0
